# رمز بخش مدیریت (بدون این مقدار، /admin باز نمی‌شود)
ADMIN_PASSWORD=

# کلید مدل دستیار؛ فقط سمت سرور خوانده می‌شود و هرگز در مرورگر یا گیت نمی‌آید
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4-flash

# جایگزین: هر اندپوینت سازگار با OpenAI
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# راز امضای نشست (اختیاری؛ پیش‌فرض از رمز مدیر ساخته می‌شود)
# ADMIN_SECRET=
