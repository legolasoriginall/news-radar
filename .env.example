# رمز بخش مدیریت (بدون این مقدار، /admin باز نمی‌شود)
ADMIN_PASSWORD=

# کلید مدل دستیار؛ فقط سمت سرور خوانده می‌شود و هرگز در مرورگر یا گیت نمی‌آید
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4-flash

# هشدار خودکار: منبع خراب یا پخش قطع‌شده به تلگرام هم برود (اختیاری)
# توکن را از @BotFather بگیر و شناسهٔ چت را از getUpdates
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# ALERT_INTERVAL_MINUTES=10
# ALERT_SILENT_HOURS=24

# بدون کلید: مدل محلی رایگان روی همین کامپیوتر (نیاز به نصب Ollama)
# OLLAMA_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2

# جایگزین: هر اندپوینت سازگار با OpenAI
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# راز امضای نشست (اختیاری؛ پیش‌فرض از رمز مدیر ساخته می‌شود)
# ADMIN_SECRET=
